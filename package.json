{
  "name": "@meddleware/nft-gate-client",
  "version": "0.0.14",
  "homepage": "https://docs.meddleware.co.uk/blockchain/sui/access-gate/",
  "type": "module",
  "description": "The nft-gate wire protocol, client side: challenge fetching, the signed personal message and access-proof encoding. No runtime dependencies.",
  "author": "MeddleWare <dev@meddleware.co.uk>",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meddleware-org/nft-gate-client.git"
  },
  "keywords": [
    "sui",
    "nft-gate",
    "access-control",
    "web3"
  ],
  "files": [
    "src",
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "eslint .",
    "lint": "npm run lint:js"
  },
  "devDependencies": {
    "@types/node": "~24.12.2",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "~5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
